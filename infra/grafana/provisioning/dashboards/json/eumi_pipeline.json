            { "type": "text", "name": "value", "config": { "text": { "mode": "field", "field": "value_text" }, "color": { "field": "status" }, "size": 30, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },

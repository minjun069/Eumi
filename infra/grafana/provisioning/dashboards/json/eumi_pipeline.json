          "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH tasks(seq, task_id, name) AS (VALUES\n  (1,'check_inputs','원본 확인'), (2,'collect_apt_trade','실거래가 수집'), (3,'geocode_apt','실거래가 좌표'), (4,'re_apt_trade','실거래가 적재'),\n  (5,'synth_anchor','가상 유동 기준'), (6,'synth_generate','가상 유동 생성'), (7,'synth_validate','가상 유동 검증'), (8,'flow_detail','유동 상세'), (9,'verify_flow_detail','유동 상세 검증'),\n  (10,'bg_detail','배경 상세'), (11,'bg_indicators','배경 지표'), (12,'bh_region_indicators','읍면동 행동 지표'), (13,'bh_grid_indicators','격자 행동 지표'),\n  (14,'region_result','읍면동 결과'), (15,'bh_contribution','지표별 기여도'), (16,'grid_anomaly','격자 이상 점수'), (17,'verify_outputs','결과 검증')),\nruns AS (\n  SELECT run_id, start_date FROM dag_run WHERE dag_id = 'eumi_monthly' ORDER BY start_date DESC LIMIT 6)\nSELECT lpad(tk.seq::text, 2, '0') || ' ' || tk.name AS \"단계\",\n       to_char(runs.start_date AT TIME ZONE 'Asia/Seoul', 'MM/DD HH24:MI') AS \"실행\",\n       ti.state AS \"상태\"\nFROM task_instance ti\nJOIN runs ON runs.run_id = ti.run_id\nJOIN tasks tk ON tk.task_id = ti.task_id\nWHERE ti.dag_id = 'eumi_monthly'\nORDER BY tk.seq, runs.start_date"
        }
      ],
      "transformations": [
        { "id": "groupingToMatrix", "options": { "columnField": "실행", "rowField": "단계", "valueField": "상태", "emptyValue": "empty" } },
        { "id": "organize", "options": { "renameByName": { "단계\\실행": "단계" } } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#23262b" },
          "custom": { "align": "center", "cellOptions": { "type": "color-background", "mode": "basic" }, "filterable": false, "inspect": false },

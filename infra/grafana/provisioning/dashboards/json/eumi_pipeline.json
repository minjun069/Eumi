{
  "__comment": "Eumi 파이프라인 대시보드. 이 파일이 원본이다 (화면에서 고친 내용은 저장되지 않음). 고치려면 파일을 바꾸고 커밋한다. 30초 안에 Grafana 가 다시 읽는다. 패널 설명은 infra/README.md. 숫자 칸은 canvas 패널: 이름(13px 회색) → 값(30px, 상태 색) → 부가 정보(12px 회색)",
  "uid": "eumi-pipeline",
  "title": "Eumi 파이프라인",
  "tags": ["eumi", "pipeline"],
  "timezone": "Asia/Seoul",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-6M", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "이번 달 한눈에",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 101,
      "type": "canvas",
      "title": "",
      "description": "Airflow 의 eumi_monthly 가장 최근 실행. 끝난 시각은 한국 시간",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT state AS status,\n       CASE WHEN end_date IS NULL THEN '시작 ' || to_char(start_date AT TIME ZONE 'Asia/Seoul', 'MM/DD HH24:MI')\n            ELSE '끝남 ' || to_char(end_date AT TIME ZONE 'Asia/Seoul', 'MM/DD HH24:MI') || ' · ' || floor(extract(epoch FROM end_date - start_date) / 60) || '분 걸림' END AS sub\nFROM dag_run\nWHERE dag_id = 'eumi_monthly'\nORDER BY start_date DESC NULLS LAST\nLIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "noValue": "실행 없음",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "mappings", "value": [
                { "type": "value", "options": {
                  "success": { "text": "성공", "color": "green", "index": 0 },
                  "failed": { "text": "실패", "color": "red", "index": 1 },
                  "running": { "text": "실행 중", "color": "blue", "index": 2 },
                  "queued": { "text": "대기", "color": "text", "index": 3 }
                } }
              ] }
            ]
          }
        ]
      },
      "options": {
        "inlineEditing": false,
        "showAdvancedTypes": true,
        "panZoom": false,
        "infinitePan": false,
        "root": {
          "type": "frame",
          "name": "root",
          "background": { "color": { "fixed": "transparent" } },
          "border": { "color": { "fixed": "transparent" } },
          "constraint": { "horizontal": "left", "vertical": "top" },
          "placement": { "top": 0, "left": 0, "width": 100, "height": 100 },
          "elements": [
            { "type": "text", "name": "label", "config": { "text": { "mode": "fixed", "fixed": "마지막 실행" }, "color": { "fixed": "#8F939E" }, "size": 13, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 4, "left": 12, "width": 280, "height": 22 } },
            { "type": "text", "name": "value", "config": { "text": { "mode": "field", "field": "status" }, "color": { "field": "status" }, "size": 30, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 30, "left": 12, "width": 280, "height": 44 } },
            { "type": "text", "name": "sub", "config": { "text": { "mode": "field", "field": "sub" }, "color": { "fixed": "#8F939E" }, "size": 12, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 80, "left": 12, "width": 280, "height": 22 } }
          ]
        }
      }
    },
    {
      "id": 102,
      "type": "canvas",
      "title": "",
      "description": "스케줄상 다음 실행 (매월 5일 03:00, 전월 처리). DAG 가 멈춰 있으면 '일시정지'",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN is_paused THEN 'paused'\n            ELSE greatest((next_dagrun_create_after AT TIME ZONE 'Asia/Seoul')::date - (now() AT TIME ZONE 'Asia/Seoul')::date, 0) || '일 뒤' END AS status,\n       CASE WHEN is_paused THEN 'Airflow 에서 DAG 를 켜야 돈다'\n            ELSE to_char(next_dagrun_create_after AT TIME ZONE 'Asia/Seoul', 'MM/DD HH24:MI') || ' · 매월 5일 03:00' END AS sub\nFROM dag\nWHERE dag_id = 'eumi_monthly'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "noValue": "DAG 없음",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "mappings", "value": [
                { "type": "value", "options": { "paused": { "text": "일시정지", "color": "orange", "index": 0 } } }
              ] }
            ]
          }
        ]
      },
      "options": {
        "inlineEditing": false,
        "showAdvancedTypes": true,
        "panZoom": false,
        "infinitePan": false,
        "root": {
          "type": "frame",
          "name": "root",
          "background": { "color": { "fixed": "transparent" } },
          "border": { "color": { "fixed": "transparent" } },
          "constraint": { "horizontal": "left", "vertical": "top" },
          "placement": { "top": 0, "left": 0, "width": 100, "height": 100 },
          "elements": [
            { "type": "text", "name": "label", "config": { "text": { "mode": "fixed", "fixed": "다음 실행" }, "color": { "fixed": "#8F939E" }, "size": 13, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 4, "left": 12, "width": 280, "height": 22 } },
            { "type": "text", "name": "value", "config": { "text": { "mode": "field", "field": "status" }, "color": { "field": "status" }, "size": 30, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 30, "left": 12, "width": 280, "height": 44 } },
            { "type": "text", "name": "sub", "config": { "text": { "mode": "field", "field": "sub" }, "color": { "fixed": "#8F939E" }, "size": 12, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 80, "left": 12, "width": 280, "height": 22 } }
          ]
        }
      }
    },
    {
      "id": 103,
      "type": "canvas",
      "title": "",
      "description": "region_result 에 있는 가장 최근 기준월과 그 달을 마지막으로 적재한 시각",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "eumi-db" },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "eumi-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(max(period_start), 'YYYY-MM') AS status,\n       to_char(max(updated_at), 'MM/DD HH24:MI') || ' 적재 · 동 ' || count(*) FILTER (WHERE period_start = (SELECT max(period_start) FROM public.region_result)) || '개' AS sub\nFROM public.region_result"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "noValue": "결과 없음",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "inlineEditing": false,
        "showAdvancedTypes": true,
        "panZoom": false,
        "infinitePan": false,
        "root": {
          "type": "frame",
          "name": "root",
          "background": { "color": { "fixed": "transparent" } },
          "border": { "color": { "fixed": "transparent" } },
          "constraint": { "horizontal": "left", "vertical": "top" },
          "placement": { "top": 0, "left": 0, "width": 100, "height": 100 },
          "elements": [
            { "type": "text", "name": "label", "config": { "text": { "mode": "fixed", "fixed": "적재된 최신 달" }, "color": { "fixed": "#8F939E" }, "size": 13, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 4, "left": 12, "width": 280, "height": 22 } },
            { "type": "text", "name": "value", "config": { "text": { "mode": "field", "field": "status" }, "color": { "field": "status" }, "size": 30, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 30, "left": 12, "width": 280, "height": 44 } },
            { "type": "text", "name": "sub", "config": { "text": { "mode": "field", "field": "sub" }, "color": { "fixed": "#8F939E" }, "size": 12, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 80, "left": 12, "width": 280, "height": 22 } }
          ]
        }
      }
    },
    {
      "id": 104,
      "type": "canvas",
      "title": "",
      "description": "pipeline_check 의 가장 최근 달에서 통과한 검사 수 / 전체. 하나라도 실패면 빨강",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "eumi-db" },
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "eumi-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH m AS (SELECT max(period_start) AS p FROM analysis.pipeline_check)\nSELECT CASE WHEN count(*) FILTER (WHERE NOT passed) = 0 THEN 'pass' ELSE 'fail' END AS status,\n       count(*) FILTER (WHERE passed) || ' / ' || count(*) || ' 통과' AS value_text,\n       to_char(m.p, 'YYYY-MM') || ' · ' || to_char(max(checked_at), 'MM/DD HH24:MI') || ' 검사' AS sub\nFROM analysis.pipeline_check c JOIN m ON c.period_start = m.p\nGROUP BY m.p"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "noValue": "기록 없음",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "mappings", "value": [
                { "type": "value", "options": {
                  "pass": { "text": "통과", "color": "green", "index": 0 },
                  "fail": { "text": "실패 있음", "color": "red", "index": 1 }
                } }
              ] }
            ]
          }
        ]
      },
      "options": {
        "inlineEditing": false,
        "showAdvancedTypes": true,
        "panZoom": false,
        "infinitePan": false,
        "root": {
          "type": "frame",
          "name": "root",
          "background": { "color": { "fixed": "transparent" } },
          "border": { "color": { "fixed": "transparent" } },
          "constraint": { "horizontal": "left", "vertical": "top" },
          "placement": { "top": 0, "left": 0, "width": 100, "height": 100 },
          "elements": [
            { "type": "text", "name": "label", "config": { "text": { "mode": "fixed", "fixed": "검사 결과 (최신 달)" }, "color": { "fixed": "#8F939E" }, "size": 13, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 4, "left": 12, "width": 280, "height": 22 } },
            { "type": "text", "name": "value", "config": { "text": { "mode": "field", "field": "value_text" }, "color": { "field": "status" }, "size": 30, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 30, "left": 12, "width": 280, "height": 44 } },
            { "type": "text", "name": "sub", "config": { "text": { "mode": "field", "field": "sub" }, "color": { "fixed": "#8F939E" }, "size": 12, "align": "left", "valign": "middle" },
              "background": { "color": { "fixed": "transparent" } }, "border": { "color": { "fixed": "transparent" } },
              "constraint": { "horizontal": "left", "vertical": "top" }, "placement": { "top": 80, "left": 12, "width": 280, "height": 22 } }
          ]
        }
      }
    },
    {
      "id": 105,
      "type": "alertlist",
      "title": "울린 알림",
      "description": "지금 켜져 있는 알림. 알림 규칙은 다음 작업에서 넣는다",

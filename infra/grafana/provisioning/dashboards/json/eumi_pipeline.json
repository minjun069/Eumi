    {
      "id": 201,
      "type": "table",
      "title": "실행 이력",
      "description": "기간 안의 eumi_monthly 실행. 기준월은 수동 실행이면 conf 의 months, 자동이면 스케줄 달. 건너뜀 = 원본이 없어 첫 단계에서 전부 skip",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
      "gridPos": { "h": 15, "w": 10, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(r.start_date AT TIME ZONE 'Asia/Seoul', 'MM/DD HH24:MI') AS \"시작\",\n       coalesce(substring(encode(r.conf, 'escape') FROM '[0-9]{4}-[0-9]{2}'), to_char(r.data_interval_start AT TIME ZONE 'Asia/Seoul', 'YYYY-MM')) AS \"기준월\",\n       CASE r.run_type WHEN 'scheduled' THEN '자동' ELSE '수동' END AS \"방식\",\n       CASE WHEN r.state = 'success' AND t.ok = 0 AND t.skip > 0 THEN 'skipped' ELSE r.state END AS \"상태\",\n       round((extract(epoch FROM r.end_date - r.start_date) / 60)::numeric, 1) AS \"걸린 시간(분)\",\n       t.ok || ' / ' || t.total AS \"성공 단계\",\n       t.failed AS \"실패한 단계\"\nFROM dag_run r\nLEFT JOIN LATERAL (\n    SELECT count(*) FILTER (WHERE state = 'success') AS ok,\n           count(*) FILTER (WHERE state = 'skipped') AS skip,\n           count(*) AS total,\n           string_agg(task_id, ', ' ORDER BY start_date) FILTER (WHERE state = 'failed') AS failed\n    FROM task_instance ti WHERE ti.dag_id = r.dag_id AND ti.run_id = r.run_id) t ON true\nWHERE r.dag_id = 'eumi_monthly' AND $__timeFilter(r.start_date)\nORDER BY r.start_date DESC\nLIMIT 50"
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": false, "inspect": false },
          "noValue": "-",
          "mappings": []
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "상태" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "custom.width", "value": 80 },
            { "id": "mappings", "value": [
              { "type": "value", "options": {
                "success": { "text": "성공", "color": "green", "index": 0 },
                "failed": { "text": "실패", "color": "red", "index": 1 },
                "running": { "text": "실행 중", "color": "blue", "index": 2 },
                "queued": { "text": "대기", "color": "text", "index": 3 },
                "skipped": { "text": "건너뜀", "color": "#8F939E", "index": 4 }
              } } ] } ] },
          { "matcher": { "id": "byName", "options": "시작" }, "properties": [ { "id": "custom.width", "value": 100 } ] },
          { "matcher": { "id": "byName", "options": "기준월" }, "properties": [ { "id": "custom.width", "value": 80 } ] },
          { "matcher": { "id": "byName", "options": "방식" }, "properties": [ { "id": "custom.width", "value": 60 } ] },
          { "matcher": { "id": "byName", "options": "걸린 시간(분)" }, "properties": [ { "id": "custom.width", "value": 110 }, { "id": "decimals", "value": 1 } ] },
          { "matcher": { "id": "byName", "options": "성공 단계" }, "properties": [ { "id": "custom.width", "value": 90 } ] }
        ]
      }
    },
    {
      "id": 202,
      "type": "barchart",
      "title": "단계별 소요 시간 (최근 실행 3번)",
      "description": "실제로 돈 최근 실행 3번의 단계별 소요 시간(분). 건너뛴 실행은 뺀다. 갑자기 길어진 단계를 찾는 용도",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
      "gridPos": { "h": 15, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH tasks(seq, task_id, name) AS (VALUES\n  (1,'check_inputs','원본 확인'), (2,'collect_apt_trade','실거래가 수집'), (3,'geocode_apt','실거래가 좌표'), (4,'re_apt_trade','실거래가 적재'),\n  (5,'synth_anchor','가상 유동 기준'), (6,'synth_generate','가상 유동 생성'), (7,'synth_validate','가상 유동 검증'), (8,'flow_detail','유동 상세'), (9,'verify_flow_detail','유동 상세 검증'),\n  (10,'bg_detail','배경 상세'), (11,'bg_indicators','배경 지표'), (12,'bh_region_indicators','읍면동 행동 지표'), (13,'bh_grid_indicators','격자 행동 지표'),\n  (14,'region_result','읍면동 결과'), (15,'bh_contribution','지표별 기여도'), (16,'grid_anomaly','격자 이상 점수'), (17,'verify_outputs','결과 검증')),\nruns AS (\n  SELECT r.run_id, r.start_date,\n         coalesce(substring(encode(r.conf, 'escape') FROM '[0-9]{4}-[0-9]{2}'), to_char(r.data_interval_start AT TIME ZONE 'Asia/Seoul', 'YYYY-MM')) AS month\n  FROM dag_run r\n  WHERE r.dag_id = 'eumi_monthly'\n    AND EXISTS (SELECT 1 FROM task_instance ti WHERE ti.dag_id = r.dag_id AND ti.run_id = r.run_id AND ti.state = 'success' AND ti.task_id <> 'check_inputs')\n  ORDER BY r.start_date DESC LIMIT 3)\nSELECT lpad(tk.seq::text, 2, '0') || ' ' || tk.name AS \"단계\",\n       to_char(runs.start_date AT TIME ZONE 'Asia/Seoul', 'MM/DD HH24:MI') || ' (' || runs.month || ')' AS \"실행\",\n       round((ti.duration / 60.0)::numeric, 1) AS \"분\"\nFROM task_instance ti\nJOIN runs ON runs.run_id = ti.run_id\nJOIN tasks tk ON tk.task_id = ti.task_id\nWHERE ti.dag_id = 'eumi_monthly' AND ti.duration IS NOT NULL\nORDER BY tk.seq, runs.start_date"
        }
      ],
      "transformations": [
        { "id": "groupingToMatrix", "options": { "columnField": "실행", "rowField": "단계", "valueField": "분", "emptyValue": "null" } }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "never",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.8,
        "barRadius": 0,
        "fullHighlight": false,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "suffix: 분",
          "decimals": 1,
          "custom": { "lineWidth": 0, "fillOpacity": 85, "gradientMode": "none", "axisPlacement": "auto", "axisLabel": "", "axisBorderShow": false },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 203,

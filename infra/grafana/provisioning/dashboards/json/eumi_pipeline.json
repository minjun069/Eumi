      "description": "기간 안 실행에서 단계마다 실패한 횟수, 재시도한 횟수(retries=1 이라 한 번 더 돈 것), 앞 단계가 실패해서 못 돈 횟수",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
      "gridPos": { "h": 15, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "airflow-db" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH tasks(seq, task_id, name) AS (VALUES\n  (1,'check_inputs','원본 확인'), (2,'collect_apt_trade','실거래가 수집'), (3,'geocode_apt','실거래가 좌표'), (4,'re_apt_trade','실거래가 적재'),\n  (5,'synth_anchor','가상 유동 기준'), (6,'synth_generate','가상 유동 생성'), (7,'synth_validate','가상 유동 검증'), (8,'flow_detail','유동 상세'), (9,'verify_flow_detail','유동 상세 검증'),\n  (10,'bg_detail','배경 상세'), (11,'bg_indicators','배경 지표'), (12,'bh_region_indicators','읍면동 행동 지표'), (13,'bh_grid_indicators','격자 행동 지표'),\n  (14,'region_result','읍면동 결과'), (15,'bh_contribution','지표별 기여도'), (16,'grid_anomaly','격자 이상 점수'), (17,'verify_outputs','결과 검증'))\nSELECT lpad(tk.seq::text, 2, '0') || ' ' || tk.name AS \"단계\",\n       count(*) FILTER (WHERE ti.state = 'failed') AS \"실패\",\n       count(*) FILTER (WHERE ti.try_number > 1) AS \"재시도\",\n       count(*) FILTER (WHERE ti.state = 'upstream_failed') AS \"중단\"\nFROM tasks tk\nLEFT JOIN task_instance ti ON ti.task_id = tk.task_id AND ti.dag_id = 'eumi_monthly'\nLEFT JOIN dag_run r ON r.dag_id = ti.dag_id AND r.run_id = ti.run_id AND $__timeFilter(r.start_date)\nGROUP BY tk.seq, tk.name\nORDER BY tk.seq"
        }

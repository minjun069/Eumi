# 로컬 개발 전용 값. 처음 한 번: cp .env.example .env  (.env는 커밋하지 않는다)
# 운영 비밀번호는 여기에 두지 않는다 (Jenkins credentials).
# 값을 바꿨다면 docker compose down -v 후 다시 up 해야 계정에 반영된다.

# 슈퍼유저 (로컬 DB를 처음 만들 때만 사용)
POSTGRES_PASSWORD=postgres_local

# Flyway (테이블 소유)
EUMI_OWNER_PASSWORD=owner_local
# Spring Boot
EUMI_APP_PASSWORD=app_local
# 데이터 분석 파이프라인
EUMI_PIPELINE_PASSWORD=pipeline_local
# FastAPI
EUMI_AI_PASSWORD=ai_local

# ----- 데이터 파이프라인 (docker compose --profile data) -----
# MinIO 루트 계정 (s3manager 웹 UI http://localhost:9001 가 이 키로 접속). 비밀번호는 8자 이상
MINIO_ROOT_USER=eumi_minio
MINIO_ROOT_PASSWORD=minio_local123
# 버킷 (raw/ · synth/ 가 이 아래에 들어간다)
MINIO_BUCKET=sgi
# 파이프라인 스크립트(호스트 Python)와 Spark가 쓰는 MinIO 접속 정보. 로컬은 루트 계정을 그대로 쓴다
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=eumi_minio
MINIO_SECRET_KEY=minio_local123
# Kafka (호스트에서 접속할 때. 컨테이너 안에서는 kafka:19092)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_FLOW=flow_hourly
# 호스트 Python 스크립트의 DB 접속 (Spark 컨테이너 안에서는 compose가 postgres 호스트 주소로 넣어 준다)
PIPELINE_DB_DSN=postgresql://eumi_pipeline:pipeline_local@localhost:5432/eumi

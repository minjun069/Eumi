# ==========================================================================
# 운영 비밀값 목록 → 서버 /srv/eumi/.env.config (소유 jenkins, 권한 600)
#
# 이 파일에는 키 이름만 둔다. 값은 서버에서 무작위로 만든다 (04 문서 3번):
#   openssl rand -hex 24
# 원본은 서버 파일 하나다. 서버가 사라질 때를 대비한 사본은 인프라 담당이 서버 밖 개인 보관함에 둔다.
# 로컬 값(app_local 등)을 운영에 쓰지 않는다. Notion · GitLab에 값을 올리지 않는다.
#
# 작성 규칙
#   - KEY=값 사이에 공백을 두지 않는다. 값 뒤에 주석을 붙이지 않는다.
#   - DB 계정 비밀번호는 postgres를 처음 띄우기 전에 정한다. 처음 기동 때 계정이 만들어지므로,
#     그 뒤에 이 파일 값만 바꾸면 접속이 실패한다 (바꾸는 방법: 06 문서 런북 R8).
# ==========================================================================

# ---------- DB (계정 4개 + 슈퍼유저) ----------
POSTGRES_PASSWORD=
EUMI_OWNER_PASSWORD=
EUMI_APP_PASSWORD=
EUMI_PIPELINE_PASSWORD=
EUMI_AI_PASSWORD=

# ---------- backend (BE가 키 이름을 정하면 추가하고 compose의 backend environment에도 한 줄 추가) ----------
# 인증 코드 · 가입 증명 해시 키. 서버에서 한 번 만들고 바꾸지 않는다 (바꾸면 이미 보낸 인증 코드 · 가입 증명이 모두 무효):
#   openssl rand -hex 32
EUMI_AUTH_HASH_KEY=
# 메일은 지금 같은 compose의 mailpit으로 보내 값이 필요 없다. 실제 SMTP로 바꾸면 SMTP_USERNAME · SMTP_PASSWORD를 추가한다

# ---------- ai (ai 서비스를 추가할 때) ----------
# GMS_API_KEY=

# ---------- 데이터 파이프라인 (MinIO · Airflow · 수집 API) ----------
# MinIO 루트 계정 = 파이프라인의 접근 키. 비밀번호 8자 이상 (openssl rand -hex 24)
MINIO_ROOT_USER=eumi_minio
MINIO_ROOT_PASSWORD=
# Airflow 메타 DB(postgres 의 airflow DB) 비밀번호. 처음 띄우기 전에 정하고, DB 계정을 만들 때 같은 값을 쓴다 (README "데이터 파이프라인 서버 구성")
AIRFLOW_DB_PASSWORD=
# Airflow 웹 로그인 (https://k15b201.p.ssafy.io/airflow)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# Airflow 세션 서명 키 (openssl rand -hex 32)
AIRFLOW_SECRET_KEY=
# 공공데이터포털 실거래가 API 일반 인증키(Decoding 값) · Kakao REST API 키 — 데이터 파트(강병민)에게 받는다
DATA_GO_KR_SERVICE_KEY=
KAKAO_REST_KEY=

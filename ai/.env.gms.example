# Copy to .env.gms and fill in the values from your GMS account.
# Keep the GMS API key in .env.gms; that file is ignored by Git.
SETTINGS_API_KEY=
# OpenAI-compatible API base URL, excluding the final /responses path.
SETTINGS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# GMS model ID confirmed for this evaluation.
SETTINGS_MODEL=gpt-6-luna

# Evaluation evidence is saved locally by the runner.
LANGFUSE_ENABLED=false

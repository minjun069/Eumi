# Required for API execution with the real model.
SETTINGS_API_KEY=
# SETTINGS_MODEL overrides the model default in settings.py.
# Defaults and validation are defined in src/settings.py.
SETTINGS_DATABASE_URL=
SETTINGS_BACKEND_URL=http://backend:8080
SETTINGS_BACKEND_TOKEN=
# OpenAI directly by default; set the actual GMS endpoint when using GMS.
# SETTINGS_BASE_URL=https://api.openai.com/v1
SETTINGS_OUTPUT_DIR=outputs/api
# SETTINGS_DATABASE_TIMEOUT=10
# SETTINGS_NOTIFICATION_TIMEOUT=1
# SETTINGS_REPORT_CONCURRENCY=2
# SETTINGS_LLM_TIMEOUT=30
# SETTINGS_MAX_STEPS=50
# SETTINGS_MAX_TOOL_CALLS=30
# SETTINGS_RUNTIME_TIMEOUT=300

# Langfuse: enable after setting keys for your Cloud or self-hosted project.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0

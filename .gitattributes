# 줄바꿈을 LF로 통일 (Windows·Mac 혼용 시 불필요한 변경 방지)
* text=auto eol=lf

# Windows 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
# 바이너리 파일
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.docx binary
*.pptx binary
*.zip binary
*.jar binary
*.twbx binary
# 평가 원문과 고정 데이터셋의 기록된 바이트 해시를 보존한다.
ai/eval/docs/nodes/originals/** -text
ai/eval/docs/originals/** -text
ai/eval/scenarios/** -text
/ai/eval/scenarios/nodes-insight-all/report-calls.json filter=lfs diff=lfs merge=lfs -text
/ai/eval/scenarios/nodes-insight-review/report-calls.json filter=lfs diff=lfs merge=lfs -text
